diff --git a/codex-rs/core/src/session/laya_controller.rs b/codex-rs/core/src/session/laya_controller.rs
new file mode 100644
index 0000000000..1a70278ede
--- /dev/null
+++ b/codex-rs/core/src/session/laya_controller.rs
@@ -0,0 +1,504 @@
+//! Laya supplies typed effort decisions; Codex owns settings, history and execution.
+//! Child pipes keep inference local and work on Windows without a listening port.
+
+use super::session::Session;
+use super::step_context::StepContext;
+use super::step_settings::ResolvedStepSettings;
+use super::turn_context::TurnContext;
+use codex_async_utils::OrCancelExt;
+use codex_features::Feature;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::MultiAgentVersion;
+use codex_protocol::protocol::TurnSettingsUpdate;
+use codex_protocol::protocol::TurnSettingsUpdateOutcome;
+use codex_protocol::protocol::WarningEvent;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::VecDeque;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+use tokio::process::Child;
+use tokio::process::ChildStdin;
+use tokio::process::ChildStdout;
+use tokio::process::Command;
+use tokio_util::sync::CancellationToken;
+
+const MAX_FRAME: usize = 1024 * 1024;
+
+struct Worker {
+    _child: Child,
+    input: ChildStdin,
+    output: BufReader<ChildStdout>,
+}
+
+impl Worker {
+    fn start() -> anyhow::Result<Self> {
+        let python = std::env::var_os("LAYA_CONTROLLER_PYTHON")
+            .ok_or_else(|| anyhow::anyhow!("launch this build with laya-codex"))?;
+        let mut command = Command::new(python);
+        // Do not pass provider credentials to the inference worker. It needs only
+        // OS/runtime/cache settings, not Codex's authentication environment.
+        command.env_clear();
+        for (key, value) in std::env::vars_os() {
+            let name = key.to_string_lossy().to_ascii_uppercase();
+            if matches!(
+                name.as_str(),
+                "PATH"
+                    | "USERNAME"
+                    | "USER"
+                    | "LOGNAME"
+                    | "COMSPEC"
+                    | "SYSTEMDRIVE"
+                    | "HOMEDRIVE"
+                    | "HOMEPATH"
+                    | "PROGRAMDATA"
+                    | "PATHEXT"
+                    | "SYSTEMROOT"
+                    | "WINDIR"
+                    | "APPDATA"
+                    | "LOCALAPPDATA"
+                    | "USERPROFILE"
+                    | "HOME"
+                    | "TEMP"
+                    | "TMP"
+                    | "TMPDIR"
+                    | "LD_LIBRARY_PATH"
+                    | "DYLD_LIBRARY_PATH"
+                    | "HF_HOME"
+                    | "HF_HUB_CACHE"
+                    | "TORCH_HOME"
+            ) || name.starts_with("LAYA_COMPANION_")
+                || name.starts_with("CUDA_")
+            {
+                command.env(key, value);
+            }
+        }
+        command
+            .args(["-I", "-m", "laya_codex_companion.controller"])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        #[cfg(windows)]
+        command.creation_flags(0x08000000); // CREATE_NO_WINDOW for the worker only.
+        let mut child = command.spawn()?;
+        Ok(Self {
+            input: child
+                .stdin
+                .take()
+                .ok_or_else(|| anyhow::anyhow!("missing worker stdin"))?,
+            output: BufReader::new(
+                child
+                    .stdout
+                    .take()
+                    .ok_or_else(|| anyhow::anyhow!("missing worker stdout"))?,
+            ),
+            _child: child,
+        })
+    }
+
+    async fn evaluate(&mut self, request: &Value) -> anyhow::Result<Value> {
+        let mut bytes = serde_json::to_vec(request)?;
+        bytes.push(b'\n');
+        anyhow::ensure!(bytes.len() <= MAX_FRAME, "evidence frame exceeds limit");
+        self.input.write_all(&bytes).await?;
+        self.input.flush().await?;
+        let mut reply = Vec::new();
+        (&mut self.output)
+            .take((MAX_FRAME + 1) as u64)
+            .read_until(b'\n', &mut reply)
+            .await?;
+        anyhow::ensure!(
+            reply.len() <= MAX_FRAME && reply.last() == Some(&b'\n'),
+            "invalid worker frame"
+        );
+        Ok(serde_json::from_slice(&reply)?)
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Controller {
+    worker: Option<Worker>,
+    generation: u64,
+    remaining: u64,
+    settings: Option<Arc<ResolvedStepSettings>>,
+    baseline: Option<ReasoningEffort>,
+    request_signature: String,
+    failure_count: usize,
+    window: String,
+    pending: Option<Value>,
+    disabled: bool,
+    decision_ms: f64,
+    cache_hits: u64,
+}
+
+impl Controller {
+    pub(super) async fn before_generation(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+        cancellation: &CancellationToken,
+    ) -> CodexResult<bool> {
+        let strict = std::env::var("LAYA_ENFORCE").as_deref() != Ok("0");
+        self.pending = None;
+        let current = turn.current_settings.load_full();
+        let selected = current.selected_collaboration_mode();
+        if !matches!(selected.model(), "laya-astra" | "laya-sol")
+            && !(strict && matches!(selected.model(), "gpt-6-astra" | "gpt-6-sol"))
+        {
+            let recapture = self.settings.is_some();
+            self.worker = None;
+            self.remaining = 0;
+            self.settings = None;
+            return Ok(recapture);
+        }
+        self.generation += 1;
+        if self.disabled {
+            if strict {
+                return Err(CodexErr::Fatal(
+                    "Laya enforcement stopped this turn".to_string(),
+                ));
+            }
+            return Ok(false);
+        }
+        if !session.enabled(Feature::StepModelSwitching)
+            || !session.enabled(Feature::ReasoningEffortOverride)
+            || turn.multi_agent_version != MultiAgentVersion::Disabled
+            || !matches!(
+                current.model_info.slug.as_str(),
+                "gpt-6-astra" | "gpt-6-sol"
+            )
+            || !current.model_info.use_responses_lite
+            || !session.provider().await.is_openai()
+        {
+            if strict {
+                return Err(CodexErr::Fatal("Laya enforcement requires single-agent mode, a supported provider, and native effort features".to_string()));
+            }
+            self.disabled = true;
+            self.notice(session, turn, "Laya inactive: adaptive effort requires standard single-agent mode and native effort features.").await;
+            return Ok(false);
+        }
+        // Any externally published snapshot wins for this generation. In particular,
+        // never overwrite a manual setting while Python is evaluating evidence.
+        if let Some(previous) = &self.settings {
+            if !Arc::ptr_eq(previous, &current) {
+                if strict {
+                    return Err(CodexErr::Fatal(
+                        "Settings changed during Laya enforcement; submit a new turn to reassess"
+                            .to_string(),
+                    ));
+                }
+                self.baseline = current.effective_reasoning_effort();
+                self.remaining = 0;
+                self.settings = Some(current);
+                self.disabled = true;
+                self.notice(
+                    session,
+                    turn,
+                    "Laya paused for this turn: settings were changed externally.",
+                )
+                .await;
+                return Ok(true); // discard any pre-captured settings and honor the manual change
+            }
+        } else {
+            self.baseline = current.effective_reasoning_effort();
+        }
+        let window = session.current_window_id().await;
+        let history = session.clone_history().await;
+        let (evidence, failures) = project_evidence(history.raw_items());
+        let signature = evidence["requests"].to_string();
+        if self.request_signature != signature
+            || self.failure_count != failures
+            || self.window != window
+        {
+            self.remaining = 0;
+        }
+        self.request_signature = signature;
+        self.failure_count = failures;
+        self.window = window;
+        if !strict && self.remaining > 0 {
+            self.remaining -= 1;
+            return Ok(false);
+        }
+        let id = format!("{}:{}", turn.sub_id, self.generation);
+        let request = json!({"protocol": 1, "id": id, "generation": self.generation,
+            "model": current.model_info.slug, "evidence": evidence, "milestones": true,
+            "supported_efforts": current.model_info.supported_reasoning_levels.iter()
+                .filter(|p| p.effort != ReasoningEffort::Ultra)
+                .map(|p| p.effort.to_string()).collect::<Vec<_>>()});
+        let evaluated = async {
+            let deadline = if self.worker.is_none() { 120 } else { 30 };
+            if self.worker.is_none() {
+                self.worker = Some(Worker::start()?);
+            }
+            let worker = self
+                .worker
+                .as_mut()
+                .ok_or_else(|| anyhow::anyhow!("worker unavailable"))?;
+            tokio::time::timeout(Duration::from_secs(deadline), worker.evaluate(&request)).await?
+        }
+        .or_cancel(cancellation)
+        .await?;
+        if !Arc::ptr_eq(&current, &turn.current_settings.load_full()) {
+            self.remaining = 0;
+            return Ok(true);
+        }
+        let decision = match evaluated {
+            Ok(reply) => validate_reply(reply, &id, self.generation, &request["supported_efforts"])
+                .and_then(|reply| {
+                    let effort: ReasoningEffort = serde_json::from_value(reply["effort"].clone())?;
+                    Ok((effort, reply))
+                }),
+            Err(error) => Err(error),
+        };
+        let (desired, record) = match decision {
+            Ok((effort, reply)) => {
+                self.remaining = reply["lease"].as_u64().unwrap_or(1) - 1;
+                (Some(effort), reply)
+            }
+            Err(error) => {
+                if strict {
+                    return Err(CodexErr::Fatal(format!(
+                        "Laya enforcement blocked generation: {error}"
+                    )));
+                }
+                // One failure disables the worker for this turn; explicit fallback is
+                // stable and cannot create a restart/load storm on every generation.
+                self.disabled = true;
+                self.worker = None;
+                self.remaining = 0;
+                self.notice(
+                    session,
+                    turn,
+                    &format!("Laya fallback to configured effort: {error}"),
+                )
+                .await;
+                (
+                    self.baseline.clone(),
+                    json!({"id": id, "generation": self.generation,
+                    "status": "fallback", "reason": error.to_string()}),
+                )
+            }
+        };
+        match session
+            .apply_turn_settings_if_current(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    effort: Some(desired.clone()),
+                    ..Default::default()
+                },
+                Some(&current),
+            )
+            .await
+        {
+            TurnSettingsUpdateOutcome::Applied => {
+                self.settings = Some(turn.current_settings.load_full());
+                self.pending = Some(
+                    json!({"decision": record, "expected_effort": desired, "expected_model": current.model_info.slug}),
+                );
+                Ok(true)
+            }
+            TurnSettingsUpdateOutcome::TargetUnavailable => Ok(true),
+            TurnSettingsUpdateOutcome::Rejected { reason } => {
+                if strict {
+                    return Err(CodexErr::Fatal(format!(
+                        "Laya enforcement could not apply effort: {reason}"
+                    )));
+                }
+                self.disabled = true;
+                self.notice(session, turn, &format!("Laya setting rejected: {reason}"))
+                    .await;
+                Ok(false)
+            }
+        }
+    }
+
+    pub(super) async fn acknowledge(
+        &mut self,
+        session: &Session,
+        step: &StepContext,
+    ) -> CodexResult<()> {
+        let strict = std::env::var("LAYA_ENFORCE").as_deref() != Ok("0");
+        let Some(mut record) = self.pending.take() else {
+            if strict
+                && matches!(
+                    step.settings.model_info.slug.as_str(),
+                    "gpt-6-astra" | "gpt-6-sol"
+                )
+            {
+                return Err(CodexErr::Fatal(
+                    "Laya enforcement: no decision for captured generation".to_string(),
+                ));
+            }
+            return Ok(());
+        };
+        let actual =
+            serde_json::to_value(step.settings.effective_reasoning_effort()).unwrap_or(Value::Null);
+        let applied = record["expected_effort"] == actual
+            && record["expected_model"] == step.settings.model_info.slug;
+        record["applied"] = json!(applied);
+        record["actual_effort"] = actual;
+        record["turn_id"] = json!(step.turn.sub_id);
+        if applied && record["decision"]["status"] == "decided" {
+            self.decision_ms += record["decision"]["elapsed_ms"].as_f64().unwrap_or(0.0);
+            self.cache_hits += u64::from(record["decision"]["runtime"]["cache_hit"] == true);
+            let choices = &record["decision"]["milestone"]["choices"];
+            let advice = format!("Laya milestone advice (partial public evidence; advisory, never permission): approach={}, verification={}, context={}. Validate against original sources. Use file context selection before bulk reads; archive and recall omitted evidence. Codex owns generation and tests.", choices["approach"], choices["verification"], choices["context"]);
+            let item = crate::context::ContextualUserFragment::into(crate::context::DeveloperInstructions::new(advice));
+            session.record_conversation_items(&step.turn, &step.settings.model_info, &[item]).await;
+
+            let effort = record["actual_effort"].as_str().unwrap_or("default");
+            self.notice(
+                session,
+                &step.turn,
+                &format!("Laya APPLIED: {effort}; generation {}", self.generation),
+            )
+            .await;
+        }
+        if let Some(dir) = std::env::var_os("LAYA_CONTROLLER_LOG_DIR") {
+            let dir = std::path::PathBuf::from(dir);
+            let result: std::io::Result<()> = async {
+                tokio::fs::create_dir_all(&dir).await?;
+                let path = dir.join(format!("{}.jsonl", session.thread_id));
+                let mut file = tokio::fs::OpenOptions::new()
+                    .create(true)
+                    .append(true)
+                    .open(path)
+                    .await?;
+                file.write_all(format!("{record}\n").as_bytes()).await
+            }
+            .await;
+            if let Err(error) = result {
+                self.notice(
+                    session,
+                    &step.turn,
+                    &format!("Laya audit log unavailable: {error}"),
+                )
+                .await;
+            }
+        }
+        if strict && (!applied || record["decision"]["status"] != "decided") {
+            return Err(CodexErr::Fatal(
+                "Laya enforcement: captured generation does not match its decision".to_string(),
+            ));
+        }
+        Ok(())
+    }
+
+    pub(super) async fn report(&self, session: &Session, turn: &TurnContext, before: codex_protocol::protocol::TokenUsage, elapsed: f64) {
+        if self.generation == 0 { return; }
+        let usage = session.token_usage_info().await;
+        let message = if let Some(info) = usage {
+            let u = info.total_token_usage;
+            format!("Laya task stats: input={} cached_input={} output={} reasoning_output={} total={} | decisions={} cached_effort_decisions={} local_ms={:.1} task_seconds={:.2}. Cached input is included in input; reasoning is included in output. Savings are not inferred.", u.input_tokens-before.input_tokens, u.cached_input_tokens-before.cached_input_tokens, u.output_tokens-before.output_tokens, u.reasoning_output_tokens-before.reasoning_output_tokens, u.total_tokens-before.total_tokens, self.generation, self.cache_hits, self.decision_ms, elapsed)
+        } else { format!("Laya task stats: provider usage unavailable | decisions={} local_ms={:.1} task_seconds={:.2}", self.generation, self.decision_ms, elapsed) };
+        self.notice(session, turn, &message).await;
+    }
+
+    async fn notice(&self, session: &Session, turn: &TurnContext, message: &str) {
+        session
+            .send_event(
+                turn,
+                EventMsg::Warning(WarningEvent {
+                    message: message.to_string(),
+                }),
+            )
+            .await;
+    }
+}
+
+fn validate_reply(
+    reply: Value,
+    id: &str,
+    generation: u64,
+    efforts: &Value,
+) -> anyhow::Result<Value> {
+    anyhow::ensure!(
+        reply["protocol"] == 1 && reply["id"] == id && reply["generation"] == generation,
+        "stale or malformed Laya response"
+    );
+    anyhow::ensure!(
+        reply["status"] == "decided",
+        "{}",
+        reply["reason"].as_str().unwrap_or("worker abstained")
+    );
+    anyhow::ensure!(
+        efforts
+            .as_array()
+            .is_some_and(|a| a.contains(&reply["effort"]))
+            && matches!(reply["lease"].as_u64(), Some(1 | 2)),
+        "invalid Laya effort or duration"
+    );
+    for (key, allowed) in [("approach", &["inspect", "implement", "verify"][..]), ("verification", &["focused", "broaden"][..]), ("context", &["retain", "select"][..])] {
+        anyhow::ensure!(reply["milestone"]["choices"][key].as_str().is_some_and(|v| allowed.contains(&v)), "invalid or missing milestone decision");
+    }
+    let _: ReasoningEffort = serde_json::from_value(reply["effort"].clone())?;
+    Ok(reply)
+}
+
+fn project_evidence<'a>(items: impl Iterator<Item = &'a ResponseItem>) -> (Value, usize) {
+    let mut requests = Vec::new();
+    let mut recent = VecDeque::new();
+    let mut omitted = 0;
+    let mut failures = 0;
+    let mut bytes = 0;
+    let mut incomplete = false;
+    for (index, item) in items.enumerate() {
+        if let Some(TurnItem::UserMessage(user)) = crate::event_mapping::parse_turn_item(item) {
+            let text = user.message();
+            bytes += text.len();
+            if bytes <= 128 * 1024 {
+                requests.push(text);
+            } else {
+                incomplete = true;
+            }
+            continue;
+        }
+        // Never serialize reasoning/encrypted items or injected developer instructions.
+        let include = matches!(item, ResponseItem::Message { role, .. } if role == "assistant")
+            || matches!(
+                item,
+                ResponseItem::FunctionCallOutput { .. } | ResponseItem::CustomToolCallOutput { .. }
+            );
+        if include && let Ok(raw) = serde_json::to_string(item) {
+            let lower = raw.to_lowercase();
+            failures += usize::from(
+                [
+                    "error",
+                    "failed",
+                    "traceback",
+                    "exit code: 1",
+                    "unsupported call:",
+                ]
+                .iter()
+                .any(|needle| lower.contains(needle)),
+            );
+            let preview: String = raw.chars().take(700).collect();
+            recent.push_back(json!({"history_index": index, "preview": preview,
+                "excerpted": raw.chars().count() > 700}));
+            if recent.len() > 6 {
+                recent.pop_front();
+                omitted += 1;
+            }
+        }
+    }
+    (
+        json!({"requests": requests, "recent": recent, "omitted_items": omitted,
+        "incomplete_requests": incomplete}),
+        failures,
+    )
+}
