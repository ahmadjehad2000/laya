+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn rejects_stale_identity_and_unadvertised_effort() {
+    let reply = json!({"protocol":1,"id":"turn:2","generation":2,"status":"decided","effort":"high","lease":1});
+    assert!(validate_reply(reply.clone(), "turn:1", 1, &json!(["high", "low"])).is_err());
+    assert!(validate_reply(reply.clone(), "turn:2", 2, &json!(["low", "medium"])).is_err());
+    assert_eq!(
+        validate_reply(reply.clone(), "turn:2", 2, &json!(["high", "low"])).unwrap(),
+        reply
+    );
+}
+
+#[test]
+fn evidence_excludes_private_reasoning_and_preserves_user_restrictions() {
+    let items: Vec<ResponseItem> = serde_json::from_value(json!([
+        {"type":"message","role":"user","content":[{"type":"input_text","text":"Fix tests. Never deploy."}]},
+        {"type":"reasoning","summary":[],"encrypted_content":"PRIVATE"},
+        {"type":"message","role":"assistant","content":[{"type":"output_text","text":"A test failed."}]}
+    ])).unwrap();
+    let (evidence, failures) = project_evidence(items.iter());
+    assert_eq!(evidence["requests"], json!(["Fix tests. Never deploy."]));
+    assert_eq!(failures, 1);
+    assert!(!evidence.to_string().contains("PRIVATE"));
+}
+
+#[test]
+fn oversized_essential_evidence_is_marked_incomplete() {
+    let items: Vec<ResponseItem> = serde_json::from_value(json!([
+        {"type":"message","role":"user","content":[{"type":"input_text","text":"x".repeat(140_000)}]}
+    ])).unwrap();
+    let (evidence, _) = project_evidence(items.iter());
+    assert_eq!(evidence["incomplete_requests"], json!(true));
+}
